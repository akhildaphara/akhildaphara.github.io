---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import SectionHeading from '../components/astro/SectionHeading.astro';
import TechBadge from '../components/astro/TechBadge.astro';
import { TypewriterText } from '../components/react/TypewriterText';
import { Mail, ExternalLink, GraduationCap, SpellCheck, CreditCard, Terminal, Package, Laptop } from 'lucide-react';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const IconMap: Record<string, any> = { SpellCheck, Laptop, CreditCard, Terminal, Package };

const colorClasses = {
  pink: { text: 'text-pink-400', borderHover: 'hover:border-pink-400/50', bgGlow: 'bg-pink-400/10', groupHoverText: 'group-hover:text-pink-400', bgDot: 'bg-pink-400/50' },
  lime: { text: 'text-lime-400', borderHover: 'hover:border-lime-400/50', bgGlow: 'bg-lime-400/10', groupHoverText: 'group-hover:text-lime-400', bgDot: 'bg-lime-400/50' },
  cyan: { text: 'text-cyan-400', borderHover: 'hover:border-cyan-400/50', bgGlow: 'bg-cyan-400/10', groupHoverText: 'group-hover:text-cyan-400', bgDot: 'bg-cyan-400/50' },
};
---

<BaseLayout>
	<Navbar />

	<main class="relative z-10 px-6 md:px-12 lg:px-24 max-w-[1600px] mx-auto" id="main-content">
		
		<!-- HERO SECTION -->
		<section id="about" class="min-h-screen flex flex-col justify-center pt-20 relative">
			<div class="hero-fade-in opacity-0 translate-y-[20px] transition-all duration-1000 ease-out space-y-6 max-w-4xl">
				<div class="font-mono text-lime-400 text-lg md:text-xl flex items-center gap-2">
					<span>&gt;</span>
					<span>system.init()</span>
				</div>

				<h1 class="font-sans font-bold text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl uppercase tracking-wider leading-[0.85]">
					<div class="overflow-hidden">
						<div class="hero-slide-up translate-y-[100%] transition-transform duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] delay-200">Akhil</div>
					</div>
					<div class="overflow-hidden">
						<div class="hero-slide-up translate-y-[100%] transition-transform duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] delay-300 flex items-center gap-4">Daphara</div>
					</div>
				</h1>

				<div class="font-mono text-slate-300 text-lg md:text-xl max-w-2xl mt-8"><TypewriterText client:load text={"> Software Engineer based in Boston, MA.\n> Specializing in backend systems, AWS, Node.js, and AI assisted development."} delay={1} /></div>

				<div class="hero-fade-in-delayed opacity-0 transition-opacity duration-1000 ease-out flex gap-4 pt-12">
					<a href="#projects" class="font-mono text-sm bg-lime-400 text-black px-6 py-3 uppercase font-bold tracking-wider hover:bg-white transition-colors">
						View Logs //
					</a>
					<a href="#connect" class="font-mono text-sm border border-slate-700 text-slate-300 px-6 py-3 uppercase tracking-wider hover:border-lime-400 hover:text-lime-400 transition-colors flex items-center gap-2">
						<Mail size={16} /> Connect
					</a>
				</div>
			</div>

			<div class="absolute right-0 top-1/2 -translate-y-1/2 opacity-5 hidden lg:block pointer-events-none">
				<h1 class="font-sans font-bold text-[30rem] leading-none whitespace-nowrap" style="writing-mode: vertical-rl;">
					ENG
				</h1>
			</div>
		</section>

		<!-- PROJECTS SECTION -->
		<section id="projects" class="py-[clamp(4rem,12vh,8rem)] relative">
			<SectionHeading>Projects</SectionHeading>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-8">
				{sortedProjects.map(project => {
					const { title, url, typeHtml, icon, iconSize, glowSize, color, colSpan, comingSoon, isBeta, featured, description, tags } = project.data;
					const Icon = IconMap[icon];
					const c = colorClasses[color as keyof typeof colorClasses];
					
					return (
						<a href={url} target="_blank" rel="noopener noreferrer" class={colSpan}>
							<div class={`group border border-slate-800 bg-slate-900/50 p-8 ${c.borderHover} hover:-translate-y-1 active:scale-[0.98] transition-all duration-300 relative overflow-hidden h-full`}>
								<div class={`absolute top-0 right-0 ${glowSize} ${c.bgGlow} rounded-bl-full -z-10 group-hover:scale-150 transition-transform duration-500`}></div>
								<div class={`font-mono ${c.text} mb-4 flex justify-between items-center`}>
									<Icon size={iconSize} />
									<span class="text-[10px] tracking-widest uppercase flex items-center gap-2">
										<span><Fragment set:html={typeHtml} /></span> <ExternalLink size={14} />
									</span>
								</div>
								<h3 class={`font-sans font-bold uppercase mb-4 text-slate-100 ${c.groupHoverText} transition-colors ${comingSoon || isBeta ? 'flex items-center gap-3' : ''} ${featured ? 'text-3xl' : 'text-2xl'}`}>
									{title}
									{comingSoon && (
										<span class="px-2 py-0.5 bg-lime-400 text-black text-[10px] font-bold rounded-sm tracking-normal">
											COMING SOON
										</span>
									)}
									{isBeta && (
										<span class="px-2 py-0.5 bg-pink-400 text-black text-[10px] font-bold rounded-sm tracking-normal">
											BETA
										</span>
									)}
								</h3>
								<p class={`font-mono text-slate-300 mb-6 leading-relaxed max-w-prose ${featured ? 'text-base' : 'text-sm'}`}>
									{description}
								</p>
								<div class="flex flex-wrap gap-2">
									{tags.map(tag => (
										<TechBadge>{tag}</TechBadge>
									))}
								</div>
							</div>
						</a>
					);
				})}
			</div>
		</section>

		<!-- EXPERIENCE SECTION -->
		<section id="experience" class="py-[clamp(4rem,12vh,8rem)] relative">
			<SectionHeading>Experience</SectionHeading>

			<div class="space-y-24">
				{sortedExperience.map(job => {
					const { role, company, date, color, tags, bullets } = job.data;
					const c = colorClasses[color as keyof typeof colorClasses];
					
					return (
						<div class="scroll-fade-up opacity-0 translate-y-[50px] transition-all duration-700 ease-out grid grid-cols-1 lg:grid-cols-[1fr_3fr] gap-8 group">
							<div class="font-mono tabular-nums">
								<div class="text-lime-400 mb-2">{date}</div>
								<div class="text-slate-400 uppercase tracking-widest text-xs mb-4">{company}</div>
							</div>
							<div class="space-y-6">
								<h3 class={`font-sans font-bold text-3xl uppercase tracking-tight text-white ${c.groupHoverText} transition-colors`}>
									{role}
								</h3>
								<ul class="font-mono text-slate-300 space-y-4 text-sm md:text-base leading-relaxed max-w-3xl">
									{bullets.map(bullet => (
										<li class="flex gap-4 items-start">
											<span class={`inline-block w-1.5 h-1.5 ${c.bgDot} mt-2 shrink-0 animate-pulse-opacity`}></span>
											<span set:html={bullet}></span>
										</li>
									))}
								</ul>
								<div class="flex flex-wrap gap-2 pt-4">
									{tags.map(tag => (
										<TechBadge>{tag}</TechBadge>
									))}
								</div>
							</div>
						</div>
					);
				})}
			</div>
		</section>

		<!-- EDUCATION SECTION -->
		<section id="education" class="py-[clamp(4rem,12vh,8rem)] relative">
			<SectionHeading>Education</SectionHeading>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="scroll-fade-up opacity-0 translate-y-[20px] transition-all duration-700 ease-out md:col-span-2 mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
					<div class="flex items-center gap-4">
						<div class="w-10 h-10 bg-slate-900 rounded-full flex items-center justify-center shrink-0">
							<GraduationCap size={24} className="text-lime-400" />
						</div>
						<div>
							<div class="font-mono text-lime-400 text-sm mb-1">May 2023</div>
							<h4 class="font-sans font-bold text-xl uppercase text-white">MS in Computer Science</h4>
							<div class="font-mono text-slate-400 text-sm">Worcester Polytechnic Institute</div>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<div class="w-10 h-10 bg-slate-900 rounded-full flex items-center justify-center shrink-0">
							<GraduationCap size={24} className="text-cyan-400" />
						</div>
						<div>
							<div class="font-mono text-cyan-400 text-sm mb-1">Oct 2020</div>
							<h4 class="font-sans font-bold text-xl uppercase text-white">BE in Information Technology</h4>
							<div class="font-mono text-slate-400 text-sm">University of Mumbai</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CONTACT SECTION -->
		<section id="connect" class="py-[clamp(4rem,12vh,8rem)] relative scroll-fade-up opacity-0 translate-y-[50px] transition-all duration-700 ease-out">
			<div class="max-w-4xl">
				<div class="font-mono text-lime-400 text-sm uppercase tracking-widest mb-4 font-bold flex items-center gap-2">
					<span>&gt;</span> contact.info()
				</div>
				<h2 class="font-sans font-bold text-5xl md:text-7xl mb-8 tracking-tight text-white uppercase">Let's connect</h2>
				
				<p class="font-mono text-slate-300 text-lg md:text-xl max-w-2xl mb-12 leading-relaxed">
					I'm always open to discussing new opportunities, interesting projects, or just having a conversation about tech. Feel free to reach out.
				</p>

				<div class="space-y-6 mb-12">
					<a href="mailto:akhildaphara@gmail.com" class="flex items-center gap-4 text-slate-300 hover:text-cyan-400 transition-colors group w-fit">
						<Mail size={24} className="group-hover:scale-110 transition-transform" />
						<span class="font-mono text-lg md:text-xl">akhildaphara@gmail.com</span>
					</a>
					<a href="https://linkedin.com/in/akhildaphara" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-slate-300 hover:text-lime-400 transition-colors group w-fit">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
						<span class="font-mono text-lg md:text-xl">linkedin.com/in/akhildaphara</span>
					</a>
					<a href="https://github.com/akhildaphara" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-slate-300 hover:text-pink-400 transition-colors group w-fit">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
						<span class="font-mono text-lg md:text-xl">github.com/akhildaphara</span>
					</a>
				</div>
			</div>
		</section>

		<!-- FOOTER -->
		<footer class="py-[clamp(3rem,8vh,6rem)] border-t border-slate-800 mt-0 flex flex-col md:flex-row justify-between items-center gap-8">
			<div class="font-sans font-bold text-2xl uppercase tracking-wider">
				Akhil Daphara
			</div>
		</footer>

	</main>
</BaseLayout>
